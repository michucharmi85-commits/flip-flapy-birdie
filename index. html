<!DOCTYPE html>
<html>
<head>
  <title>Flappy Sky</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * {
      box-sizing: border-box;
      touch-action: manipulation;
    }

    body {
      margin: 0;
      background: #222;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
      font-family: Arial, sans-serif;
    }

    canvas {
      background: skyblue;
      max-width: 100vw;
      max-height: 100vh;
    }
  </style>
</head>

<body>

<canvas id="game" width="400" height="600"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let bird;
let pipes;
let score;
let gameOver;
let started;

function resetGame() {
  bird = {
    x: 80,
    y: 300,
    size: 18,
    velocity: 0,
    gravity: 0.45,
    jump: -7
  };

  pipes = [];
  score = 0;
  gameOver = false;
  started = false;
}

function flap() {
  if (gameOver) {
    resetGame();
    return;
  }

  started = true;
  bird.velocity = bird.jump;
}

function createPipe() {
  const gap = 150;
  const topHeight = Math.random() * 250 + 50;

  pipes.push({
    x: canvas.width,
    width: 60,
    top: topHeight,
    bottom: topHeight + gap,
    passed: false
  });
}

function update() {
  if (!started || gameOver) return;

  bird.velocity += bird.gravity;
  bird.y += bird.velocity;

  if (
    pipes.length === 0 ||
    pipes[pipes.length - 1].x < 220
  ) {
    createPipe();
  }

  for (let pipe of pipes) {
    pipe.x -= 2.5;

    if (!pipe.passed && pipe.x + pipe.width < bird.x) {
      pipe.passed = true;
      score++;
    }

    // Collision
    if (
      bird.x + bird.size > pipe.x &&
      bird.x - bird.size < pipe.x + pipe.width &&
      (bird.y - bird.size < pipe.top ||
       bird.y + bird.size > pipe.bottom)
    ) {
      gameOver = true;
    }
  }

  pipes = pipes.filter(pipe => pipe.x + pipe.width > 0);

  if (
    bird.y - bird.size < 0 ||
    bird.y + bird.size > canvas.height
  ) {
    gameOver = true;
  }
}

function drawBird() {
  ctx.fillStyle = "#FFD43B";
  ctx.beginPath();
  ctx.arc(bird.x, bird.y, bird.size, 0, Math.PI * 2);
  ctx.fill();

  // Eye
  ctx.fillStyle = "white";
  ctx.beginPath();
  ctx.arc(bird.x + 7, bird.y - 6, 5, 0, Math.PI * 2);
  ctx.fill();

  ctx.fillStyle = "black";
  ctx.beginPath();
  ctx.arc(bird.x + 9, bird.y - 6, 2, 0, Math.PI * 2);
  ctx.fill();

  // Beak
  ctx.fillStyle = "orange";
  ctx.beginPath();
  ctx.moveTo(bird.x + 17, bird.y);
  ctx.lineTo(bird.x + 29, bird.y + 5);
  ctx.lineTo(bird.x + 17, bird.y + 9);
  ctx.fill();
}

function drawPipes() {
  for (let pipe of pipes) {
    ctx.fillStyle = "#35A853";

    ctx.fillRect(
      pipe.x,
      0,
      pipe.width,
      pipe.top
    );

    ctx.fillRect(
      pipe.x,
      pipe.bottom,
      pipe.width,
      canvas.height - pipe.bottom
    );

    // Pipe caps
    ctx.fillStyle = "#238636";

    ctx.fillRect(
      pipe.x - 5,
      pipe.top - 20,
      pipe.width + 10,
      20
    );

    ctx.fillRect(
      pipe.x - 5,
      pipe.bottom,
      pipe.width + 10,
      20
    );
  }
}

function draw() {
  // Sky
  ctx.fillStyle = "#70C5CE";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Clouds
  ctx.fillStyle = "rgba(255,255,255,0.8)";
  ctx.beginPath();
  ctx.arc(80, 100, 25, 0, Math.PI * 2);
  ctx.arc(110, 100, 35, 0, Math.PI * 2);
  ctx.arc(145, 100, 25, 0, Math.PI * 2);
  ctx.fill();

  drawPipes();
  drawBird();

  // Score
  ctx.fillStyle = "white";
  ctx.strokeStyle = "black";
  ctx.lineWidth = 4;
  ctx.font = "bold 45px Arial";
  ctx.textAlign = "center";
  ctx.strokeText(score, canvas.width / 2, 60);
  ctx.fillText(score, canvas.width / 2, 60);

  if (!started && !gameOver) {
    ctx.fillStyle = "white";
    ctx.font = "bold 28px Arial";
    ctx.fillText(
      "TAP TO START",
      canvas.width / 2,
      280
    );
  }

  if (gameOver) {
    ctx.fillStyle = "rgba(0,0,0,0.5)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = "white";
    ctx.font = "bold 42px Arial";
    ctx.fillText(
      "GAME OVER",
      canvas.width / 2,
      270
    );

    ctx.font = "24px Arial";
    ctx.fillText(
      "Tap to restart",
      canvas.width / 2,
      320
    );
  }
}

function gameLoop() {
  update();
  draw();
  requestAnimationFrame(gameLoop);
}

canvas.addEventListener("click", flap);
canvas.addEventListener("touchstart", flap);

document.addEventListener("keydown", function(event) {
  if (event.code === "Space") {
    flap();
  }
});

resetGame();
gameLoop();
</script>

</body>
</html>